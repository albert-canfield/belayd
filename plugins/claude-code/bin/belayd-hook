#!/bin/sh
# Runs belayd's Claude Code hook for the belayd plugin. The plugin cannot run `belayd init`,
# so this keeps its own copy of belayd, pinned to the plugin's version, in
# ~/.belayd/runtime and installs it from npm the first time (at session start, so tool
# calls stay fast). When belayd cannot run, the call is blocked, never let through.
VERSION=0.4.0
ROOT="${BELAYD_HOME:-$HOME/.belayd}/runtime"
DIR="$ROOT/$VERSION"
BIN="$DIR/node_modules/belayd-cli/dist/bin.js"

install() {
  [ -f "$BIN" ] && return 0
  command -v npm >/dev/null 2>&1 || return 1
  mkdir -p "$ROOT" || return 1
  # One install at a time: parallel hooks wait for the first one.
  tries=0
  until mkdir "$DIR.lock" 2>/dev/null; do
    [ -f "$BIN" ] && return 0
    tries=$((tries + 1))
    [ "$tries" -gt 110 ] && return 1
    sleep 1
  done
  if [ ! -f "$BIN" ]; then
    rm -rf "$DIR.tmp"
    npm install --prefix "$DIR.tmp" --no-audit --no-fund --silent "belayd-cli@$VERSION" >/dev/null 2>&1 &&
      rm -rf "$DIR" && mv "$DIR.tmp" "$DIR"
  fi
  rmdir "$DIR.lock" 2>/dev/null
  [ -f "$BIN" ]
}

if [ "$1" = "--prepare" ]; then
  install
  exit 0
fi
if install && command -v node >/dev/null 2>&1; then
  exec node "$BIN" hook "$@"
fi
echo "belayd could not start (it needs Node.js 22 or newer and npm), so this action is blocked to be safe. Run: npm install -g belayd-cli" >&2
exit 2
